{
  "name": "octo-dashboard-app",
  "version": "2.0.0",
  "description": "Dashboard pengelola akun (Electron + React + TypeScript + Vite)",
  "main": "./out/main/index.js",
  "author": "Octo Dashboard",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.octodashboard.app",
    "productName": "Octo Dashboard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Octo Dashboard"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "imapflow": "^1.6.5",
    "mailparser": "^3.9.14",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.2.7",
    "electron-builder": "^26.15.2",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "zustand": "^4.5.4"
  }
}
